# Copy to ~/.plasma-plugin/config.env and fill in — or let the
# plasma-plugin-setup skill ask you for each value and write them for you.
#
# This file does NOT belong in the plugin directory: a plugin installed from a
# marketplace lives in a cache directory that is replaced on update, and
# anything kept there is lost. Environment variables override every value
# below, so a one-off can point at another deployment without editing this.
#
# Empty means unconfigured; nothing here is guessed for you.

# --- Plasma ------------------------------------------------------------------
# The Plasma API endpoint, e.g. http://127.0.0.1:5001
PLASMA_URL=

# Authenticate one of two ways. A static token is used verbatim and never
# refreshed; username/password logs in and maintains the JWT for you.
PLASMA_TOKEN=
PLASMA_USERNAME=
PLASMA_PASSWORD=

# --- Ophion ------------------------------------------------------------------
# Ophion's query-mcp is a cluster-internal API. From a workstation this is
# usually a port-forward, e.g.
#   kubectl -n <ns> port-forward svc/ophion 5101:5101
# then OPHION_URL=http://127.0.0.1:5101
OPHION_URL=
OPHION_SERVICE_TOKEN=

# Tool profile for Ophion's read side: all, qa, text_to_sql, fhir or audit.
# It is fixed for the session — switching it would change the tool list.
# Empty means "all".
OPHION_PROFILE=
