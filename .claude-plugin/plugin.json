{
  "name": "plasma-plugin",
  "displayName": "Plasma + Ophion",
  "description": "以 Ophion 知識查核來源與 SQL，建立 mview 資料 API，或透過 view → blueprint → PG 匯出至使用者選定的資料表。",
  "version": "0.1.6",
  "author": {
    "name": "Brobridge",
    "email": "bbgai@brobridge.com"
  },
  "keywords": [
    "plasma",
    "ophion",
    "data-api",
    "materialized-view",
    "knowledge"
  ],
  "mcpServers": {
    "plasma": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/plasma-mcp.sh",
      "args": [
        "plasma"
      ]
    },
    "ophion": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/plasma-mcp.sh",
      "args": [
        "ophion"
      ]
    }
  }
}
