{
  "name": "plasma-plugin",
  "displayName": "Plasma + Ophion",
  "description": "Operate Plasma with Ophion's knowledge: pick a workspace, look up how the source system was designed, verify SQL, build a materialized view and publish it as a data API.",
  "version": "0.1.5",
  "author": {
    "name": "Brobridge",
    "email": "bbgai@brobridge.com"
  },
  "keywords": [
    "plasma",
    "ophion",
    "data-api",
    "materialized-view",
    "knowledge"
  ],
  "mcpServers": {
    "plasma": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/plasma-mcp.sh",
      "args": [
        "plasma"
      ]
    },
    "ophion": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/plasma-mcp.sh",
      "args": [
        "ophion"
      ]
    }
  }
}
