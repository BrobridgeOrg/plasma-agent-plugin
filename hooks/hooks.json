{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plasma-config.sh\" session-start",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create_view|sync_view|create_access_entry|spawn_blueprint_job)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plasma-mcp.sh\" hook",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
